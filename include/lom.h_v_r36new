/* lom.h - common prelude for rebuilt lomse.exe functions (Lords of Magic SE 3.01).
 * Ghidra 12.2 pseudo-C types and helper ops, plus minimal Win32 types.
 * Rebuilt code is freestanding: it calls original code and imports through
 * fixed addresses in the original image (base 0x00400000, no relocations). */
#ifndef LOM_H
#define LOM_H
#include <stdint.h>
#include <stddef.h>
typedef unsigned char undefined, undefined1, byte, uchar, BYTE, UCHAR, BOOLEAN;
typedef unsigned short undefined2, ushort, word, WORD, wchar16, USHORT, WCHAR;
typedef unsigned int undefined3, undefined4, uint, dword, DWORD, UINT, ULONG, ulong;
typedef unsigned long long undefined5, undefined6, undefined7, undefined8, ulonglong, qword;
typedef long long longlong;
typedef char sbyte;
typedef long double float10;
typedef unsigned char bool;
#define true 1
#define false 0
typedef undefined4 code();          /* unknown-signature code pointer target */
typedef void *pointer, *pointer32;
typedef int BOOL, INT, LONG, HRESULT, LSTATUS, MMRESULT, LRESULT, LPARAM;
typedef short SHORT;
typedef unsigned int WPARAM, UINT_PTR, ULONG_PTR, DWORD_PTR, SIZE_T, LCID, LCTYPE, REGSAM, ATOM;
typedef char CHAR, *LPSTR, *PCNZCH, *LPCH;
typedef char *LPCSTR; /* v_r36: non-const (Ghidra writes through LPCSTR-typed temps) */
typedef unsigned short *LPWSTR, *LPWCH; typedef unsigned short *LPCWSTR, *PCNZWCH;
typedef void *HANDLE, *HWND, *HINSTANCE, *HMODULE, *HDC, *HKEY, *HGLOBAL, *HLOCAL, *HRGN,
  *HMENU, *HCURSOR, *HICON, *HACCEL, *HGDIOBJ, *HPALETTE, *HBITMAP, *HFONT, *HBRUSH, *LPVOID, *PVOID;
typedef const void *LPCVOID;
typedef DWORD *LPDWORD; typedef WORD *LPWORD; typedef LONG *PLONG; typedef BOOL *LPBOOL; typedef BYTE *LPBYTE;
typedef HKEY *PHKEY;
typedef struct tagPOINT { LONG x, y; } POINT, *LPPOINT;
typedef struct tagRECT { LONG left, top, right, bottom; } RECT, *LPRECT;
typedef struct _FILETIME { union { DWORD lo; DWORD dwLowDateTime; }; union { DWORD hi; DWORD dwHighDateTime; }; } FILETIME, *LPFILETIME;
typedef struct _GUID { DWORD d1; WORD d2, d3; BYTE d4[8]; } GUID;
typedef void *LPSECURITY_ATTRIBUTES, *LPMSG, *LPSYSTEMTIME, *LPWIN32_FIND_DATAA,
  *LPOVERLAPPED, *LPTIME_ZONE_INFORMATION, *LPSTARTUPINFOA, *LPPALETTEENTRY,
  *LPMEMORYSTATUS, *LPCPINFO, *LPTOP_LEVEL_EXCEPTION_FILTER, *LPTIMECALLBACK, *LPTHREAD_START_ROUTINE,
  *FARPROC, *DLGPROC, *WNDPROC;
struct tagMSG { HWND hwnd; UINT message; WPARAM wParam; LPARAM lParam; DWORD time; POINT pt; };
typedef struct tagMSG MSG; typedef struct _EXCEPTION_POINTERS _EXCEPTION_POINTERS;
/* Ghidra names some Win32/CRT structs by their struct tag (no 'struct' keyword) */
typedef struct tagMSG tagMSG; typedef struct tagPOINT tagPOINT; typedef struct tagRECT tagRECT; typedef struct _FILETIME _FILETIME;
typedef struct _cpinfo { UINT MaxCharSize; BYTE DefaultChar[2]; BYTE LeadByte[12]; } _cpinfo;
typedef struct _WIN32_FIND_DATAA { DWORD dwFileAttributes; FILETIME ftCreationTime, ftLastAccessTime, ftLastWriteTime;
  DWORD nFileSizeHigh, nFileSizeLow, dwReserved0, dwReserved1; char cFileName[260]; char cAlternateFileName[14]; } _WIN32_FIND_DATAA;
typedef struct tm { int tm_sec, tm_min, tm_hour, tm_mday, tm_mon, tm_year, tm_wday, tm_yday, tm_isdst; } tm;
typedef struct tagWNDCLASSA WNDCLASSA; typedef struct _SHELLEXECUTEINFOA SHELLEXECUTEINFOA;

/* v_r36: real layouts (were void) */
typedef struct _EXCEPTION_RECORD { DWORD ExceptionCode; DWORD ExceptionFlags; struct _EXCEPTION_RECORD *ExceptionRecord; void *ExceptionAddress;
  DWORD NumberParameters; DWORD ExceptionInformation[15]; } _EXCEPTION_RECORD, EXCEPTION_RECORD, *PEXCEPTION_RECORD;
_Static_assert(sizeof(EXCEPTION_RECORD) == 80, "EXCEPTION_RECORD");
typedef void *PRTL_CRITICAL_SECTION_DEBUG;
typedef struct _RTL_CRITICAL_SECTION { PRTL_CRITICAL_SECTION_DEBUG DebugInfo; LONG LockCount; LONG RecursionCount; HANDLE OwningThread;
  HANDLE LockSemaphore; DWORD SpinCount; } _RTL_CRITICAL_SECTION, RTL_CRITICAL_SECTION, CRITICAL_SECTION, *LPCRITICAL_SECTION, *PRTL_CRITICAL_SECTION;
_Static_assert(sizeof(CRITICAL_SECTION) == 24, "CS");
struct _SHELLEXECUTEINFOA { DWORD cbSize; ULONG fMask; HWND hwnd; LPCSTR lpVerb, lpFile, lpParameters, lpDirectory; int nShow; HINSTANCE hInstApp;
  void *lpIDList; LPCSTR lpClass; HKEY hkeyClass; DWORD dwHotKey; HANDLE hIcon; HANDLE hProcess; };
_Static_assert(sizeof(struct _SHELLEXECUTEINFOA) == 60, "SEI");
typedef struct _IMAGE_DOS_HEADER IMAGE_DOS_HEADER;
typedef char *va_list_;
typedef char *va_list; /* MSVC va_list (gen v21; FormatMessageA Arguments) */
typedef struct _SYSTEMTIME { uint16_t wYear, wMonth, wDayOfWeek, wDay, wHour, wMinute, wSecond, wMilliseconds; } _SYSTEMTIME;
typedef struct _TIME_ZONE_INFORMATION { int32_t Bias; uint16_t StandardName[32]; _SYSTEMTIME StandardDate; int32_t StandardBias;
  uint16_t DaylightName[32]; _SYSTEMTIME DaylightDate; int32_t DaylightBias; } _TIME_ZONE_INFORMATION;
typedef struct _SECURITY_ATTRIBUTES { uint32_t nLength; void *lpSecurityDescriptor; int32_t bInheritHandle; } _SECURITY_ATTRIBUTES;
typedef struct _STARTUPINFOA { uint32_t cb; char *lpReserved, *lpDesktop, *lpTitle; uint32_t dwX, dwY, dwXSize, dwYSize,
  dwXCountChars, dwYCountChars, dwFillAttribute, dwFlags; uint16_t wShowWindow, cbReserved2; unsigned char *lpReserved2;
  void *hStdInput, *hStdOutput, *hStdError; } _STARTUPINFOA;
_Static_assert(sizeof(_TIME_ZONE_INFORMATION) == 172 && sizeof(_STARTUPINFOA) == 68 && sizeof(_SECURITY_ATTRIBUTES) == 12, "win32 struct sizes");

#define LOM_ADDR(t, a) ((t)(uintptr_t)(a))
/* globals by address */
#define LOM_G(t, a) (*(t *)(uintptr_t)(a))

/* ---- Ghidra pcode helper ops ---- */
/* SUBxy take the BITS of x: a float/double-typed operand (Ghidra types GS VM values as float) must be bit-cast,
 * a C cast would convert numerically (004b1f50: SUB41(fStack_4,0) of an int-tagged value gave 0) */
#define __LOM_U32(x) __builtin_choose_expr(__builtin_types_compatible_p(__typeof__(x), float), __BC(uint, x), (uint)(x))
#define __LOM_U64(x) __builtin_choose_expr(__builtin_types_compatible_p(__typeof__(x), double), __BC(ulonglong, x), (ulonglong)(x))
#define CONCAT11(a,b) ((ushort)(((ushort)(uchar)(a)<<8)|(uchar)(b)))
#define CONCAT12(a,b) ((uint)(((uint)(uchar)(a)<<16)|(ushort)(b)))
#define CONCAT13(a,b) ((uint)(((uint)(uchar)(a)<<24)|((uint)(b)&0xffffffu)))
#define CONCAT21(a,b) ((uint)(((uint)(ushort)(a)<<8)|(uchar)(b)))
#define CONCAT22(a,b) ((uint)(((uint)(ushort)(a)<<16)|(ushort)(b)))
#define CONCAT31(a,b) ((uint)((__LOM_U32(a)<<8)|(uchar)(b)))
#define CONCAT14(a,b) ((ulonglong)(((ulonglong)(uchar)(a)<<32)|__LOM_U32(b)))
#define CONCAT24(a,b) ((ulonglong)(((ulonglong)(ushort)(a)<<32)|__LOM_U32(b)))
#define CONCAT34(a,b) ((ulonglong)(((ulonglong)(__LOM_U32(a)&0xffffffu)<<32)|__LOM_U32(b)))
#define CONCAT44(a,b) ((ulonglong)(((ulonglong)__LOM_U32(a)<<32)|__LOM_U32(b)))
#define CONCAT41(a,b) ((ulonglong)(((ulonglong)__LOM_U32(a)<<8)|(uchar)(b)))
#define CONCAT42(a,b) ((ulonglong)(((ulonglong)__LOM_U32(a)<<16)|(ushort)(b)))
#define CONCAT15(a,b) ((ulonglong)(((ulonglong)((ulonglong)(a)&0xffull)<<40)|((ulonglong)(b)&0xffffffffffull)))
#define CONCAT16(a,b) ((ulonglong)(((ulonglong)((ulonglong)(a)&0xffull)<<48)|((ulonglong)(b)&0xffffffffffffull)))
#define CONCAT17(a,b) ((ulonglong)(((ulonglong)((ulonglong)(a)&0xffull)<<56)|((ulonglong)(b)&0xffffffffffffffull)))
#define CONCAT25(a,b) ((ulonglong)(((ulonglong)((ulonglong)(a)&0xffffull)<<40)|((ulonglong)(b)&0xffffffffffull)))
#define CONCAT26(a,b) ((ulonglong)(((ulonglong)((ulonglong)(a)&0xffffull)<<48)|((ulonglong)(b)&0xffffffffffffull)))
#define CONCAT35(a,b) ((ulonglong)(((ulonglong)((ulonglong)(a)&0xffffffull)<<40)|((ulonglong)(b)&0xffffffffffull)))
#define ROUND(x) ({ long double _lom_r; __asm__("frndint" : "=t"(_lom_r) : "0"((long double)(x))); _lom_r; }) /* x87 frndint, current rounding mode */
#define SUB21(x,o) ((uchar)((ushort)(x)>>(8*(o))))
#define SUB41(x,o) ((uchar)(__LOM_U32(x)>>(8*(o))))
#define SUB42(x,o) ((ushort)(__LOM_U32(x)>>(8*(o))))
#define SUB81(x,o) ((uchar)(__LOM_U64(x)>>(8*(o))))
#define SUB82(x,o) ((ushort)(__LOM_U64(x)>>(8*(o))))
#define SUB84(x,o) ((uint)(__LOM_U64(x)>>(8*(o))))
#define SUB43(x,o) ((uint)((__LOM_U32(x)>>(8*(o)))&0xffffffu))
#define ZEXT12(x) ((ushort)(uchar)(x))
#define ZEXT14(x) ((uint)(uchar)(x))
#define ZEXT24(x) ((uint)(ushort)(x))
#define ZEXT18(x) ((ulonglong)(uchar)(x))
#define ZEXT28(x) ((ulonglong)(ushort)(x))
#define ZEXT48(x) ((ulonglong)__LOM_U32(x))
#define ZEXT34(x) (__LOM_U32(x)&0xffffffu)
#define SEXT12(x) ((short)(signed char)(x))
#define SEXT14(x) ((int)(signed char)(x))
#define SEXT24(x) ((int)(short)(x))
#define SEXT48(x) ((longlong)(int)(x))
#define SEXT18(x) ((longlong)(signed char)(x))
#define SEXT28(x) ((longlong)(short)(x))
#define CARRY1(a,b) ((uchar)((uchar)(a)+(uchar)(b)) < (uchar)(a))
#define CARRY2(a,b) ((ushort)((ushort)(a)+(ushort)(b)) < (ushort)(a))
#define CARRY4(a,b) ((uint)((uint)(a)+(uint)(b)) < (uint)(a))
#define SCARRY1(a,b) __lom_scarry1((signed char)(a),(signed char)(b))
static inline int __lom_scarry1(signed char a, signed char b){ signed char r; return __builtin_add_overflow(a,b,&r); }
#define SCARRY2(a,b) __lom_scarry2((short)(a),(short)(b))
#define SCARRY4(a,b) __lom_scarry4((int)(a),(int)(b))
#define SBORROW1(a,b) __lom_sborrow1((signed char)(a),(signed char)(b))
#define SBORROW2(a,b) __lom_sborrow2((short)(a),(short)(b))
#define SBORROW4(a,b) __lom_sborrow4((int)(a),(int)(b))
static inline int __lom_scarry2(short a, short b){ short r; return __builtin_add_overflow(a,b,&r); }
static inline int __lom_scarry4(int a, int b){ int r; return __builtin_add_overflow(a,b,&r); }
static inline int __lom_sborrow1(signed char a, signed char b){ signed char r; return __builtin_sub_overflow(a,b,&r); }
static inline int __lom_sborrow2(short a, short b){ short r; return __builtin_sub_overflow(a,b,&r); }
static inline int __lom_sborrow4(int a, int b){ int r; return __builtin_sub_overflow(a,b,&r); }
#define POPCOUNT(x) __builtin_popcount((uint)(x))
#define LZCOUNT(x) ((x)?__builtin_clz((uint)(x)):32)
/* ---- x87 intrinsics Ghidra emits (exact instruction semantics) ---- */
static inline float10 fsin(float10 x){ float10 r; __asm__("fsin" : "=t"(r) : "0"(x)); return r; }
static inline float10 fcos(float10 x){ float10 r; __asm__("fcos" : "=t"(r) : "0"(x)); return r; }
static inline float10 SQRT(float10 x){ float10 r; __asm__("fsqrt" : "=t"(r) : "0"(x)); return r; }
static inline float10 ABS(float10 x){ float10 r; __asm__("fabs" : "=t"(r) : "0"(x)); return r; }
/* Ghidra fpatan(a,b): x87 FPATAN = atan(ST1/ST0) with ST1=a, ST0=b */
static inline float10 fpatan(float10 a, float10 b){ float10 r; __asm__("fpatan" : "=t"(r) : "0"(b), "u"(a) : "st(1)"); return r; }
static inline float10 fptan(float10 x){ float10 r; __asm__("fptan\n\tfstp %%st(0)" : "=t"(r) : "0"(x)); return r; }
#define NAN (__builtin_nanl(""))
struct _iobuf { char *_ptr; int _cnt; char *_base; int _flag; int _file; int _charbuf; int _bufsiz; char *_tmpfname; };
typedef struct _iobuf FILE; _Static_assert(sizeof(FILE) == 32, "FILE");
#endif

/* Bit reinterpretation (Ghidra pcode CAST/SUBPIECE between float and int types; tools/bitcast.py).
 * Copies the low min(sizeof) bytes, zero-filling the rest. */
#define __BC(T, x) ({ __typeof__(x) _bc_s = (x); T _bc_d; __builtin_memset(&_bc_d, 0, sizeof(_bc_d)); \
  __builtin_memcpy(&_bc_d, &_bc_s, sizeof(_bc_d) < sizeof(_bc_s) ? sizeof(_bc_d) : sizeof(_bc_s)); _bc_d; })

/* Ghidra's names for inlined constant copies (mov-immediate store sequences); strncpy semantics = zero padded */
static inline char *builtin_strncpy(char *d, const char *s, unsigned n) { unsigned i = 0;
  for (; i < n && s[i]; i++) d[i] = s[i]; for (; i < n; i++) d[i] = 0; return d; }
static inline void *builtin_memcpy(void *d, const void *s, unsigned n) { unsigned i;
  for (i = 0; i < n; i++) ((char *)d)[i] = ((const char *)s)[i]; return d; }
